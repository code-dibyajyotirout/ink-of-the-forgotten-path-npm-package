{
  "name": "ink-of-the-forgotten-path",
  "version": "0.1.0",
  "description": "Production-grade, browser-native 3D martial arts action engine, WebGPU/Three.js rendering pipelines, OneEuroFilter signal processing, and distributed full-stack architecture.",
  "author": "Dibyajyoti Rout <code.dibyajyotirout@gmail.com> (https://github.com/code-dibyajyotirout)",
  "license": "AGPL-3.0-only",
  "keywords": [
    "threejs",
    "webgpu",
    "martial-arts",
    "browser-game",
    "one-euro-filter",
    "signal-processing",
    "nextjs",
    "game-engine",
    "distributed-systems",
    "typescript",
    "biomechanics"
  ],
  "homepage": "https://github.com/code-dibyajyotirout/ink-of-the-forgotten-path-npm-package#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dibyajyotirout/ink-of-the-forgotten-path-npm-package.git"
  },
  "bugs": {
    "url": "https://github.com/code-dibyajyotirout/ink-of-the-forgotten-path-npm-package/issues"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.mjs",
      "default": "./dist/hooks.mjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "default": "./dist/components.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "default": "./dist/utils.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:lib": "tsup && node -e '[\"index\",\"hooks\",\"components\",\"utils\"].forEach(s => fs.writeFileSync(\"dist/\" + s + \".d.ts\", \"export * from \\\"./\" + s + \".d.mts\\\";\\n\"))'",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:backend": "pytest backend/tests",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "howler": "^2.2.4",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.11",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "24.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite": "5.4.11",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.8"
  }
}
